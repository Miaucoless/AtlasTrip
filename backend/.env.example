# AtlasTrip Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Supabase (replace MongoDB + custom JWT)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI (for AI trip optimization and chatbot)
OPENAI_API_KEY=sk-...

# OpenWeather (for weather forecasts)
OPENWEATHER_API_KEY=your_openweather_api_key

# Amadeus (for flight search and booking)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# Mapbox (for map tiles and directions)
MAPBOX_TOKEN=pk.your_mapbox_token

# Client origin (for CORS)
CLIENT_ORIGIN=*
