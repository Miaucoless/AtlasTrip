# AtlasTrip Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/atlastrip

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_me
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_me

# OpenAI (for AI trip optimization and chatbot)
OPENAI_API_KEY=sk-...

# OpenWeather (for weather forecasts)
OPENWEATHER_API_KEY=your_openweather_api_key

# Client origin (for CORS)
CLIENT_ORIGIN=*
